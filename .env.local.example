# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — solo per gli embedding RAG (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Meta WhatsApp Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
META_WHATSAPP_ACCESS_TOKEN=EAAxxxxx...

# Email (Resend) — EMAIL_FROM deve usare un dominio verificato su Resend
RESEND_API_KEY=re_...
EMAIL_FROM=sensor-smart@damtec.net

# App URL / Site URL (usati nei link di notifica e nei link email set-password).
# In produzione entrambi = URL Netlify.
NEXT_PUBLIC_APP_URL=https://fenix-support.netlify.app
NEXT_PUBLIC_SITE_URL=https://fenix-support.netlify.app

# Cron reperibilità: segreto condiviso tra il job pg_cron (Supabase) e /api/cron/on-call
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contesto tecnico aggiuntivo per l'AI (opzionale, sovrascrive il DB)
# FENIX_SYSTEM_CONTEXT=...
